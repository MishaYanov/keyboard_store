# Copy to .env here. Never commit real credentials.
APP_ORIGIN=https://shop.example.com
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_PREFIX=keycaps
RELEASE_TAG=mock-KEY-GIT-COMMIT
COMMERCE_MODE=live
# Must be on an actually mounted persistent disk, never a free ephemeral instance.
API_DATABASE=/data/production.sqlite
SQLITE_PERSISTENT=true
API_ADMIN_KEY=mock-KEY-REPLACE-WITH-RANDOM-32-BYTE-SECRET
SHOPIFY_STORE_DOMAIN=mock-KEY-production.myshopify.com
SHOPIFY_CHECKOUT_DOMAIN=mock-KEY-production.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=mock-KEY-PRODUCTION-STOREFRONT-PRIVATE
SHOPIFY_WEBHOOK_SECRET=mock-KEY-PRODUCTION-WEBHOOK
SHOPIFY_VARIANT_MAP='{}'
