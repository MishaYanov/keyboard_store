# Copy to .env here; replace placeholders before starting. Never commit secrets.
APP_ORIGIN=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
IMAGE_PREFIX=keycaps
RELEASE_TAG=CHANGE_ME_FULL_GIT_COMMIT
COMMERCE_MODE=mock
API_ADMIN_KEY=CHANGE_ME_RANDOM_32_BYTE_SECRET
# Docker mounts a persistent volume at /data. Render Free must use /tmp instead.
API_DATABASE=/data/staging-mock.sqlite
SQLITE_PERSISTENT=true
# Optional: COMMERCE_MODE=live requires a separate Shopify test store and these values.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CHECKOUT_DOMAIN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_VARIANT_MAP='{}'
