# Render Free: disposable MOCK API only. These fields go in Render Environment Variables.
NODE_VERSION=24.21.0
NODE_ENV=production
DEPLOY_ENV=staging
COMMERCE_MODE=mock
API_HOST=0.0.0.0
# API_PORT may be omitted: the server reads Render's PORT automatically.
API_DATABASE=/tmp/keycaps-demo.sqlite
SQLITE_PERSISTENT=false
# Set the actual frontend HTTPS origin; it needs same-origin /api proxy routing.
APP_ORIGIN=https://your-frontend.onrender.com
API_ADMIN_KEY=mock-KEY-REPLACE-WITH-GENERATED-SECRET
