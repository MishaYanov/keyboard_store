# Server-only configuration. Restart the API after changes.
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
DEPLOY_ENV=development
COMMERCE_MODE=mock
API_HOST=127.0.0.1
API_PORT=3001
# Relative to server/ when started with npm run api:dev. Tests use temporary files.
API_DATABASE=./data/commerce-mock.sqlite
SQLITE_PERSISTENT=false
API_TRUST_PROXY=false
API_ADMIN_KEY=mock-KEY-ADMIN-API-REPLACE-WITH-32-RANDOM-BYTES
SHOPIFY_STORE_DOMAIN=mock-KEY.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CHECKOUT_DOMAIN=mock-KEY.myshopify.com
SHOPIFY_VARIANT_MAP={}

# Never use the VITE_ prefix for these secrets.
SHOPIFY_ADMIN_ACCESS_TOKEN=mock-KEY-ADMIN
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=mock-KEY-STOREFRONT-PRIVATE
SHOPIFY_WEBHOOK_SECRET=mock-KEY-WEBHOOK
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=mock-KEY-CUSTOMER-ACCOUNT
